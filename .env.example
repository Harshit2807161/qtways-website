# QTWAYS Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE
# ===========================================
# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com/
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/qtways?retryWrites=true&w=majority

# ===========================================
# AUTHENTICATION
# ===========================================
# JWT Secret for signing tokens (generate a random 32+ character string)
# You can generate one with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ===========================================
# SMS GATEWAY (Choose one)
# ===========================================

# Option 1: MSG91 (Recommended for India)
# Get credentials from: https://msg91.com/
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=QTWAYS
MSG91_TEMPLATE_ID=your-template-id

# Option 2: Twilio (International)
# Get credentials from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# APPLICATION
# ===========================================
# Your application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Node environment
NODE_ENV=development
